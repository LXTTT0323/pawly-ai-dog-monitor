# Local LiveKit: run `docker compose up livekit`, then use ws://localhost:7880.
LIVEKIT_URL=ws://localhost:7880
NEXT_PUBLIC_SITE_URL=http://localhost:3000
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret

# Pawly accounts: create a Supabase project, then copy its Project URL and
# publishable key from Project Settings > API. Pawly uses email/password auth;
# Google sign-in can be added later after enabling Google in Supabase Auth.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# AI is off by default. Monitoring and session coaching still work without it.
AI_FEATURE_ENABLED=false
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
AI_DAILY_REQUEST_LIMIT=20
AI_MONTHLY_BUDGET_USD=5

# A 32-byte-or-longer random value used only to encrypt each room's E2EE key.
PAWLY_KEY_ENCRYPTION_SECRET=

# Optional Vercel beta deployment bridge. Use separate, high-entropy values.
PAWLY_VERCEL_ACCESS_KEY=
PAWLY_VERCEL_BRIDGE_SECRET=
PAWLY_VERCEL_OWNER_EMAIL=
PAWLY_VERCEL_OWNER_NAME=
PAWLY_ALLOWED_ORIGINS=

# Local preview fallback only. Production uses Supabase when the keys above exist.
PAWLY_LOCAL_OWNER_EMAIL=owner@pawly.local
