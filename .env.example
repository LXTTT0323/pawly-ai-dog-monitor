# Local LiveKit: run `docker compose up livekit`, then use ws://localhost:7880.
LIVEKIT_URL=ws://localhost:7880
NEXT_PUBLIC_SITE_URL=http://localhost:3000
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret

# AI is off by default. Monitoring and session coaching still work without it.
AI_FEATURE_ENABLED=false
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
AI_DAILY_REQUEST_LIMIT=20
AI_MONTHLY_BUDGET_USD=5

# A 32-byte-or-longer random value used only to encrypt each room's E2EE key.
PAWLY_KEY_ENCRYPTION_SECRET=

# Local preview only. Production identity is provided by Pawly's sign-in flow.
PAWLY_LOCAL_OWNER_EMAIL=owner@pawly.local
